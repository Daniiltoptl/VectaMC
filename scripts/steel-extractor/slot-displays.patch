+package com.steelextractor.extractors
+
+import com.google.gson.GsonBuilder
+import com.google.gson.JsonArray
+import com.google.gson.JsonObject
+import net.minecraft.SharedConstants
+import net.minecraft.core.registries.BuiltInRegistries
+import net.minecraft.server.Bootstrap
+import java.nio.charset.StandardCharsets
+import java.nio.file.Files
+import java.nio.file.Path
+
+/** Extracts the built-in wire registry without starting a server or loading a world. */
+object SlotDisplayRegistry {
+    @JvmStatic
+    fun main(args: Array<String>) {
+        require(args.isEmpty()) { "Use STEEL_EXTRACTOR_OUTPUT_DIRECTORY to select the output directory" }
+        SharedConstants.tryDetectVersion()
+        Bootstrap.bootStrap()
+        val entries = JsonArray()
+        val registry = BuiltInRegistries.SLOT_DISPLAY
+        for (entry in registry) {
+            entries.add(JsonObject().apply {
+                addProperty("id", registry.getId(entry))
+                addProperty("key", requireNotNull(registry.getKey(entry)).toString())
+            })
+        }
+        val root = JsonObject().apply {
+            addProperty("minecraft_version", SharedConstants.getCurrentVersion().id())
+            add("entries", entries)
+        }
+        val directory = Path.of(System.getenv("STEEL_EXTRACTOR_OUTPUT_DIRECTORY") ?: "steel_extractor_output")
+        val output = directory.resolve("steel-registry/build_assets/slot_displays.json")
+        Files.createDirectories(output.parent)
+        Files.newBufferedWriter(output, StandardCharsets.UTF_8).use { writer ->
+            GsonBuilder().disableHtmlEscaping().setPrettyPrinting().create().toJson(root, writer)
+            writer.appendLine()
+        }
+        println("Wrote ${output.toAbsolutePath()}")
+    }
+}
